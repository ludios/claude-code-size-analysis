{
  "name": "claude-code-size-analysis",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "download": "node src/download_vsix.ts",
    "process": "node src/process_vsix.ts",
    "chart": "node src/build_chart.ts",
    "analyze": "node src/analyze_bun.ts",
    "composition-chart": "node src/build_composition_chart.ts",
    "context": "unshare --map-current-user --net --pid --fork --kill-child --keep-caps node src/measure_context.ts",
    "context-chart": "node src/build_context_chart.ts",
    "prompt-history": "node src/build_prompt_history.ts",
    "pipeline": "pnpm run download && pnpm run process && pnpm run analyze && pnpm run chart && pnpm run composition-chart && pnpm run context && pnpm run context-chart && pnpm run prompt-history",
    "check": "tsc --noEmit && oxlint"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.21.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@logtape/logtape": "^2.3.2",
    "ayy": "^4.1.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@logtape/lint": "^2.3.2",
    "@types/node": "^26.2.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  }
}
